# ---------- BACKEND (backend/.env or Railway variables). Placeholders only. ----------
APP_ENV=development                 # production on Railway
DATABASE_URL=sqlite:///./dev.db     # Railway: ${{Postgres.DATABASE_URL}}  (postgres:// is auto-converted)
FRONTEND_ORIGIN=http://localhost:5173   # production: https://your-site.vercel.app (comma-separate several)
SESSION_SECRET=change-me-generate-with-python-secrets-token_urlsafe-48
SESSION_TTL_MINUTES=480
COOKIE_SAMESITE=lax                 # 'lax' when using the Vercel /api proxy (recommended); 'none' for cross-site
INITIAL_ADMIN_EMAIL=                # optional one-time bootstrap; remove the password after first start
INITIAL_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE_BYTES=10485760

STORAGE_BACKEND=local               # local (dev only) | s3 (required in production)
LOCAL_STORAGE_DIR=./storage
OBJECT_STORAGE_ENDPOINT=            # blank for AWS S3; R2: https://<account>.r2.cloudflarestorage.com; MinIO: http://localhost:9000
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto          # R2: auto, AWS: e.g. ap-south-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---------- FRONTEND (frontend/.env.local or Vercel). Public values only, never secrets. ----------
# Leave unset to call the relative '/api' path (dev proxy locally, Vercel rewrite in production).
# VITE_API_BASE_URL=https://your-api.up.railway.app/api
